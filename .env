# FYERS API app credentials — from https://myapi.fyers.in → My Apps
FYERS_APP_ID=SJT0COZD50-100
FYERS_SECRET_ID=XHRO9GAGDV

# The public URL of THIS backend once deployed on Render, no trailing slash.
# Must exactly match what you register as the app's Redirect URL in the
# FYERS API dashboard as: https://your-service.onrender.com/auth/callback
PUBLIC_URL=https://butterfly-kzpf.onrender.com

# Where your dashboard HTML is hosted (the popup's opener window).
# Used for CORS and as the postMessage target origin.
FRONTEND_ORIGIN=https://efinlearning.github.io

# Neon Postgres connection string — from your Neon project's Dashboard →
# Connection Details. Use the POOLED connection string (has "-pooler" in
# the hostname) since Render's small connection pool + Neon's serverless
# nature work best together with pgbouncer in front. sslmode=require is
# mandatory — Neon rejects unencrypted connections.
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Render sets PORT automatically — you normally don't need to set this yourself.
PORT=10000
